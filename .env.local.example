# Frontend Google Identity Services Web client ID.
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Under "Authorized JavaScript origins" add exactly:
#   http://localhost:3000
#   https://your-real-production-domain.example
# Do NOT add /login as an OAuth redirect: the login page uses a popup token client.
# Sign-in is OPTIONAL. Without this value, anyone can still create and download
# local videos. YouTube channel connection requires this client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required only for authenticated backend integrations (OAuth account sessions,
# server-side YouTube connection, scheduling). Not needed for guest creation.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
