# Public Google OAuth Client ID for direct frontend YouTube connect/upload.
# One Web client can be used by many app users. Each user signs in with their own
# Google account in the browser and uploads to their own connected YouTube channel.
# Add all allowed dev/prod JavaScript origins in Google Cloud Cloud, e.g. http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Backend API URL (Express.js server for scheduled uploads + server-side YouTube OAuth)
# Run the backend with: cd backend && npm run dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
