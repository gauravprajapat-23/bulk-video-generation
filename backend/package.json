{
  "name": "video-maker-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test:security": "tsx --test tests/*.test.ts",
    "check:security": "npm run lint && npm run test:security && npm run build",
    "test:scheduler:db": "tsx --test tests/integration/schedulerClaims.test.ts",
    "preflight:release": "tsx src/releasePreflight.ts",
    "check:release": "npm run check:security && npm run preflight:release",
    "accept:quiz": "tsx src/quizAcceptance.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
