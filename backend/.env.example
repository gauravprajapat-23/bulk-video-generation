# Copy to backend/.env and replace ALL example values (never commit actual credentials).
# NODE_ENV=development for local work; production requires explicit preflight.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_SECRET
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Local development defaults to backend/uploads. In production this MUST be an
# absolute path on a durable volume mounted for all web and scheduler workers.
# MEDIA_STORAGE_DIR=/absolute/persistent/uploads
# MEDIA_STORAGE_PERSISTENT=true

# Production default: scheduler disabled unless opted-in on one dedicated worker.
SCHEDULER_ENABLED=false
# SCHEDULER_SINGLE_INSTANCE_ACK=true

# QUIZ-005 (opt-in): anonymous long-form Remotion video rendering uses substantial
# CPU, disk and RAM. Keep FALSE in public production until rate-limit, worker
# isolation and reverse-proxy abuse protections are deployment-verified.
QUIZ_GUEST_RENDER_ENABLED=false

# AUTO-QUIZ-01: authorized channel upload, private by default, off by default.
# Requires scheduler enabled on exactly one worker and user OAuth refresh token.
QUIZ_AUTOMATION_ENABLED=false
# Set these only if you enable niche-to-quiz AI authoring (no CSV).
# OPENAI_API_KEY=server_side_key_never_expose_in_frontend
# QUIZ_AI_MODEL=gpt-4.1-mini

# AUTO-QUIZ-02: recurring channel studio (separate explicit opt-in).
# Requires QUIZ_AUTOMATION_ENABLED=true, a connected authorized channel, and
# OPENAI_API_KEY. Scheduler must be single-instance and operator-approved.
QUIZ_STUDIO_SCHEDULING_ENABLED=false

# AUTO-QUIZ-03 release controls (all OFF by default)
# Costly per-question OpenAI speech is only generated when explicitly opted in.
QUIZ_STUDIO_TTS_ENABLED=false
# Creator review + separate publication confirmation are required.
# Do NOT enable before testing the exact YouTube OAuth visibility-update scope.
QUIZ_STUDIO_PUBLICATION_ENABLED=false

# AUTO-QUIZ-04 — optional bounded evidence discovery (candidate search, not proof).
QUIZ_STUDIO_SOURCE_CHECK_ENABLED=false
# Fail closed if FFmpeg audio analysis is requested but the executable is absent.
QUIZ_STUDIO_AUDIO_QA_ENABLED=false
# FFMPEG_PATH=ffmpeg
